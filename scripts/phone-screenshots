#!/usr/bin/env bash
# Takes the README's phone screenshots into images/: the cards inside the
# Companion app on the Android VM test's Pixel 8. Needs nested KVM. Commit
# the images afterwards.
set -euo pipefail
cd "$(dirname "$0")/.."
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
scripts/android-vm "$out"
find "$out" -name 'phone-*.png' -exec cp {} images/ \;
